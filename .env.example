# TrustGate local environment
# Copy to .env at the repository root. Do not commit .env.

# --- Phase 1 (required to boot) ---
APP_ENV=local
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Vite reads this repository-root file (frontend envDir).
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Database ---
# Direct PostgreSQL URL for SQLAlchemy and asyncpg.
# Put the real Supabase string in .env only. Never commit it.
DATABASE_URL=

# Owner-role URL for Alembic. Leave empty to reuse DATABASE_URL.
# This is not a Supabase Auth key. Never commit the real value.
MIGRATION_DATABASE_URL=

# Optional local scratch PostgreSQL URL for integration tests only.
# Integration tests require this explicitly and never fall back to DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres:test_only@localhost:5432/trustgate_test

# --- Supabase Auth: backend-only ---
# Keep these values out of VITE_ variables and browser bundles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_KEY_SECRET=
SECURITY_EVENT_KEY_SECRET=
# Dedicated URL-safe base64 encoding of a random 32-byte AES-256 key.
# Backend-only; keep the same key available across deployments and back it up separately from the database.
# The application does not support changing this key as a rotation procedure. Changing or losing it
# makes existing encrypted TOTP credentials undecryptable. Do not replace it to attempt rotation.
# If production deployment, key compromise, or a formal rotation policy later requires rotation,
# safely design and implement application-supported rotation before changing the configured key.
TOTP_SECRET_ENCRYPTION_KEY=

# --- Supabase Auth: frontend-public ---
# The Supabase URL and anon key are public browser configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Later phases (leave unset until that phase uses them) ---
# DEVICE_HASH_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# TRUSTED_PROXIES=
# GEOIP_DB_PATH=
# TREAT_LOCALHOST_AS_SECURE=
# BLOCK_INDICATOR_LIMIT=3
